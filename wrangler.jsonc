{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "school-manager-website",
  "main": "worker.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/School-Manager-Setup.exe",
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "SCHOOL_MANAGER_APP",
      "bucket_name": "school-manager-app"
    }
  ],
  "d1_databases": [
    {
      "binding": "REGISTRY_DB",
      "database_name": "school-manager-registry",
      // TODO: replace with the real D1 id after `wrangler d1 create school-manager-registry`.
      "database_id": "23cc94dd-13bb-41de-88d1-ffaaf05986e6"
    }
  ]
}
